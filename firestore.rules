rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
// These are the source of truth for access control. The client is untrusted;
// anything not allowed here must not be relied on by app code.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsEmail(email) {
      return isSignedIn()
             && request.auth.token.email != null
             && email == request.auth.token.email.lower();
    }

    // Public profile records.
    //
    // `get` only — deliberately NOT `read`, which would also grant `list`.
    // A signed-in user can fetch a profile whose uid they already hold (their
    // own, or one of their contacts), but cannot query the collection to
    // harvest every registered address.
    match /users/{uid} {
      allow get: if isSignedIn();
      allow write: if isOwner(uid)
                   && request.resource.data.uid == uid
                   // Stops a user publishing an address they don't own, which
                   // would let them intercept contact requests meant for it.
                   && ownsEmail(request.resource.data.email);

      // A user's own contact list. Private to them — nobody else can see who
      // someone has added, and nobody can add themselves to your list.
      match /contacts/{contactUid} {
        allow read, write: if isOwner(uid);
      }
    }

    // Email -> uid, keyed by the address so lookup is a get, not a query.
    // Same `get`-without-`list` trick: you can resolve an address you already
    // know, which is what adding a contact needs, but you cannot list the
    // collection — and since the address IS the document ID, granting `list`
    // here would hand over every email in one request.
    match /emailIndex/{email} {
      allow get: if isSignedIn();
      allow write: if ownsEmail(email) && request.resource.data.uid == request.auth.uid;
    }
  }
}
