rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
// These are the source of truth for access control. The client is untrusted;
// anything not allowed here must not be relied on by app code.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsEmail(email) {
      return isSignedIn()
             && request.auth.token.email != null
             && email == request.auth.token.email.lower();
    }

    // Public profile records.
    //
    // `get` only — deliberately NOT `read`, which would also grant `list`.
    // A signed-in user can fetch a profile whose uid they already hold (their
    // own, or one of their contacts), but cannot query the collection to
    // harvest every registered address.
    match /users/{uid} {
      allow get: if isSignedIn();
      allow write: if isOwner(uid)
                   && request.resource.data.uid == uid
                   // Stops a user publishing an address they don't own, which
                   // would let them intercept contact requests meant for it.
                   && ownsEmail(request.resource.data.email);

      // A user's own contact list. Private to them — nobody else can see who
      // someone has added, and nobody can add themselves to your list.
      match /contacts/{contactUid} {
        allow read, write: if isOwner(uid);
      }

      // Who this user has blocked. Private to them, so a blocked person is
      // never told. The message rule below still reads it with exists(), which
      // bypasses these read rules — that is what lets a block be enforced
      // without the sender being able to see the list.
      match /blocked/{blockedUid} {
        allow read, write: if isOwner(uid);
      }

      // Push tokens for this user's devices. Owner-only: a token is enough to
      // send someone notifications, so nobody else may read or add one. The
      // Cloud Function reads them through the Admin SDK, which bypasses rules.
      match /pushTokens/{token} {
        allow read, write: if isOwner(uid);
      }
    }

    // Email -> uid, keyed by the address so lookup is a get, not a query.
    // Same `get`-without-`list` trick: you can resolve an address you already
    // know, which is what adding a contact needs, but you cannot list the
    // collection — and since the address IS the document ID, granting `list`
    // here would hand over every email in one request.
    match /emailIndex/{email} {
      allow get: if isSignedIn();
      allow write: if ownsEmail(email) && request.resource.data.uid == request.auth.uid;
    }

    // 1:1 conversations. The document ID is the two uids sorted and joined,
    // so both sides derive the same ID and cannot create duplicates.
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      // Checked against the incoming document, for the create that has no
      // resource.data to read yet.
      function joiningAsParticipant() {
        return isSignedIn()
               && request.auth.uid in request.resource.data.participants
               && request.resource.data.participants.size() == 2
               // Binds the participants to the ID, so nobody can write a
               // conversation claiming members who never agreed to it.
               && conversationId == request.resource.data.participants.join('_');
      }

      // `list` is what backs the chat list. Safe to grant because the rule is
      // evaluated against every document the query returns, so a query that
      // could surface someone else's conversation fails outright rather than
      // filtering — the client must ask for its own, which it does via
      // array-contains on its own uid.
      allow get, list: if isParticipant();
      allow create: if joiningAsParticipant();
      allow update: if isParticipant() && joiningAsParticipant();

      match /messages/{messageId} {
        // Membership is read off the conversation ID rather than fetched from
        // the parent document. Two reasons: a batched write is evaluated
        // against pre-batch state, so on the first message the parent does not
        // exist yet and a get() would reject it; and a get() in rules bills as
        // a document read on every single message.
        //
        // This is only sound because the ID encodes the participants and the
        // parent rule above binds the two together. Group chats will have
        // generated IDs and will have to fetch the parent instead.
        function inConversation() {
          return isSignedIn() && request.auth.uid in conversationId.split('_');
        }

        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // The other half of the ID is the recipient.
        function recipientUid() {
          return conversationId.split('_')[0] == request.auth.uid
                 ? conversationId.split('_')[1]
                 : conversationId.split('_')[0];
        }

        // Blocking has to be enforced here rather than only hidden in the UI,
        // or a blocked user could still write into the conversation directly.
        // Costs one document read per message sent, which is the price of the
        // block meaning anything at all.
        function notBlockedByRecipient() {
          return !exists(
            /databases/$(database)/documents/users/$(recipientUid())/blocked/$(request.auth.uid)
          );
        }

        // Hiding a message for yourself. Touches deletedFor and nothing else,
        // and only ever adds your own uid — so one participant cannot un-hide,
        // hide on behalf of the other, or slip an edit through alongside.
        //
        // Read with defaults because messages written before deletion existed
        // carry neither field, and a missing field is an error in rules rather
        // than a null; without that, those messages could never be hidden.
        // The uid must actually end up present, or a write changing nothing
        // about deletion would satisfy every other condition vacuously.
        function hidingForSelf() {
          let before = resource.data.get('deletedFor', []);
          let after = request.resource.data.get('deletedFor', []);
          return changedKeys().hasOnly(['deletedFor'])
                 && after.hasAll(before)
                 && after.hasOnly(before.concat([request.auth.uid]))
                 && after.hasAny([request.auth.uid]);
        }

        // Withdrawing for both sides is the sender's alone. This is the only
        // path allowed to clear content, and it must genuinely set the flag —
        // which is what stops it being used as cover for editing text.
        function withdrawingOwn() {
          return resource.data.senderId == request.auth.uid
                 && changedKeys().hasOnly(['deletedForEveryone', 'text', 'mediaUrl',
                                           'durationMs', 'latitude', 'longitude'])
                 && resource.data.get('deletedForEveryone', false) == false
                 && request.resource.data.get('deletedForEveryone', false) == true
                 && request.resource.data.text == '';
        }

        allow read: if inConversation();
        // Senders can only write as themselves.
        allow create: if inConversation()
                      && request.resource.data.senderId == request.auth.uid
                      && notBlockedByRecipient();
        // senderId and sentAt appear in neither branch's key list, so they can
        // never be rewritten.
        allow update: if inConversation() && (hidingForSelf() || withdrawingOwn());
        // Never hard deleted: the tombstone is what tells the other side that
        // something was removed.
        allow delete: if false;
      }
    }
  }
}
