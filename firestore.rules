rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
// These are the source of truth for access control. The client is untrusted;
// anything not allowed here must not be relied on by app code.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsEmail(email) {
      return isSignedIn()
             && request.auth.token.email != null
             && email == request.auth.token.email.lower();
    }

    // Public profile records.
    //
    // `get` only — deliberately NOT `read`, which would also grant `list`.
    // A signed-in user can fetch a profile whose uid they already hold (their
    // own, or one of their contacts), but cannot query the collection to
    // harvest every registered address.
    match /users/{uid} {
      allow get: if isSignedIn();
      allow write: if isOwner(uid)
                   && request.resource.data.uid == uid
                   // Stops a user publishing an address they don't own, which
                   // would let them intercept contact requests meant for it.
                   && ownsEmail(request.resource.data.email);

      // A user's own contact list. Private to them — nobody else can see who
      // someone has added, and nobody can add themselves to your list.
      match /contacts/{contactUid} {
        allow read, write: if isOwner(uid);
      }
    }

    // Email -> uid, keyed by the address so lookup is a get, not a query.
    // Same `get`-without-`list` trick: you can resolve an address you already
    // know, which is what adding a contact needs, but you cannot list the
    // collection — and since the address IS the document ID, granting `list`
    // here would hand over every email in one request.
    match /emailIndex/{email} {
      allow get: if isSignedIn();
      allow write: if ownsEmail(email) && request.resource.data.uid == request.auth.uid;
    }

    // 1:1 conversations. The document ID is the two uids sorted and joined,
    // so both sides derive the same ID and cannot create duplicates.
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      // Checked against the incoming document, for the create that has no
      // resource.data to read yet.
      function joiningAsParticipant() {
        return isSignedIn()
               && request.auth.uid in request.resource.data.participants
               && request.resource.data.participants.size() == 2
               // Binds the participants to the ID, so nobody can write a
               // conversation claiming members who never agreed to it.
               && conversationId == request.resource.data.participants.join('_');
      }

      // `list` is what backs the chat list. Safe to grant because the rule is
      // evaluated against every document the query returns, so a query that
      // could surface someone else's conversation fails outright rather than
      // filtering — the client must ask for its own, which it does via
      // array-contains on its own uid.
      allow get, list: if isParticipant();
      allow create: if joiningAsParticipant();
      allow update: if isParticipant() && joiningAsParticipant();

      match /messages/{messageId} {
        // Membership is read off the conversation ID rather than fetched from
        // the parent document. Two reasons: a batched write is evaluated
        // against pre-batch state, so on the first message the parent does not
        // exist yet and a get() would reject it; and a get() in rules bills as
        // a document read on every single message.
        //
        // This is only sound because the ID encodes the participants and the
        // parent rule above binds the two together. Group chats will have
        // generated IDs and will have to fetch the parent instead.
        function inConversation() {
          return isSignedIn() && request.auth.uid in conversationId.split('_');
        }

        allow read: if inConversation();
        // Senders can only write as themselves, and messages are immutable —
        // no edit or delete, so neither side can rewrite what was said.
        allow create: if inConversation() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
